# Server
PORT=5000
NODE_ENV=development

# Database
# Use DATABASE_URL for Neon or other hosted Postgres providers.
# Example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=
DB_SSL=true

# Local Postgres fallback, used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=erp_system

# JWT
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
